# Same Postgres (Supabase) database the FastAPI backend uses — copy DATABASE_URL from backend/.env
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST]:5432/postgres
# Random 32+ byte secret used to sign the dashboard session cookie (openssl rand -hex 32)
SESSION_SECRET=change-me
# FastAPI backend, used by the demo simulator widget (defaults to the Render deployment)
BACKEND_URL=https://catalyst-api-wn32.onrender.com
