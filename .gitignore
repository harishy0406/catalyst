# Ignore everything by default
*

# Keep the repo itself and the specific project files we want
!.gitignore
!requirements.txt
!README.md
!render.yaml
!assest/
!assest/**
!docs/
!docs/**
!frontend/
!frontend/**
!backend/
!backend/**
!ml/
!ml/**
!ml/models/*.pkl

# Backend container files
!backend/
!backend/Dockerfile
!backend/.dockerignore

# Supervisor dashboard (Next.js); its own .gitignore drops node_modules/.next/.env.local
!frontend/
!frontend/supervisor-dashboard/
!frontend/supervisor-dashboard/**

# Python and environment noise
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
ENV/
env/

# Jupyter / notebooks
.ipynb_checkpoints/

# Environment files
.env
.env.*
!.env.example
!**/.env.example

# OS / editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Data / model artifacts

*.joblib
*.h5
*.hdf5
*.model
*.bin
**/catboost_info/
**/tmp/

# Logs and caches
*.log
*.out
*.tmp
.cache/

# Build output
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
htmlcov/

# Local frontend / backend runtime files
node_modules/
backend/.venv/
frontend/.venv/
